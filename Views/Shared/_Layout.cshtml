<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - POC</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyASPNetCoreApp.styles.css" asp-append-version="true" />

    <!-- CodeMirror CSS + Theme -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/monokai.min.css" />

    <!-- CodeMirror JS + C# Mode -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/clike/clike.min.js"></script>

    <link href='https://fonts.googleapis.com/css?family=Roboto' rel='stylesheet'>
</head>
<body>
    <div class="page-container">
        <header>
           <h4 style="margin-bottom: 0px;">.NET Core Static Analysis Code Review Tool [Proof of Concept]</h4>
        </header>
        <main>
            @RenderBody()
        </main>
        <footer>
          <small>&copy; 2025 Thant Sin Lin - Auckland University of Technology</small>
        </footer>
    </div>

    <!-- <div class="container-main">
        <header class="site-header">
            
        </header>

        <main class="flex-grow-1 d-flex">
            @RenderBody()
        </main>

        <footer class="site-footer text-center py-3">
            
        </footer>
    </div> -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
